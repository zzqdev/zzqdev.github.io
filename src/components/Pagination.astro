---
import { Icon } from '@astrojs/starlight/components';

const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const isRtl = dir === 'rtl';
---

{
	(prev || next) && (
		<nav class="pagination-links print:hidden" dir={dir} aria-label="分页">
			{
				prev ? (
					<a href={prev.href} rel="prev">
						<Icon name={isRtl ? 'right-arrow' : 'left-arrow'} size="0.875rem" />
						<span class="text">
							<span class="label">{Astro.locals.t('page.previousLink')}</span>
							<span class="link-title">{prev.label}</span>
						</span>
					</a>
				) : (
					<span class="placeholder" />
				)
			}
			{
				next ? (
					<a href={next.href} rel="next">
						<span class="text">
							<span class="label">{Astro.locals.t('page.nextLink')}</span>
							<span class="link-title">{next.label}</span>
						</span>
						<Icon name={isRtl ? 'left-arrow' : 'right-arrow'} size="0.875rem" />
					</a>
				) : (
					<span class="placeholder" />
				)
			}
		</nav>
	)
}

<style>
	.pagination-links {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.5rem;
		margin-block-start: 1.5rem;
	}

	a,
	.placeholder {
		min-width: 0;
	}

	a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.4rem 0.65rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		text-decoration: none;
		color: var(--sl-color-gray-2);
		transition:
			color 0.15s ease,
			border-color 0.15s ease,
			background-color 0.15s ease;
	}

	a:hover {
		color: var(--sl-color-white);
		border-color: var(--sl-color-gray-3);
		background-color: color-mix(in srgb, var(--sl-color-gray-6) 70%, transparent);
	}

	[rel='next'] {
		justify-content: flex-end;
		text-align: end;
	}

	.text {
		display: flex;
		flex-direction: column;
		gap: 0.05rem;
		min-width: 0;
	}

	.label {
		font-size: 0.7rem;
		line-height: 1.2;
		color: var(--sl-color-gray-3);
	}

	.link-title {
		font-size: var(--sl-text-sm);
		font-weight: 600;
		line-height: 1.3;
		color: var(--sl-color-white);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	a:hover .link-title {
		color: var(--sl-color-accent-high);
	}

	svg {
		flex-shrink: 0;
		opacity: 0.7;
	}
</style>
