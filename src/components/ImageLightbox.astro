---
/**
 * Site-wide image lightbox for markdown/MDX content.
 * Powered by Viewer.js: click to open, wheel/toolbar to zoom, drag to pan.
 */
---

<script>
	import Viewer from 'viewerjs';
	import 'viewerjs/dist/viewer.css';

	const ROOT = '.sl-markdown-content';

	/** @type {import('viewerjs').default | null} */
	let viewer = null;

	function destroy() {
		if (!viewer) return;
		viewer.destroy();
		viewer = null;
	}

	function bind() {
		destroy();

		const root = document.querySelector(ROOT);
		if (!(root instanceof HTMLElement)) return;

		viewer = new Viewer(root, {
			filter(image) {
				return image instanceof HTMLImageElement && !image.closest('a[href]');
			},
			toolbar: {
				zoomIn: 1,
				zoomOut: 1,
				oneToOne: 1,
				reset: 1,
				prev: 1,
				play: 0,
				next: 1,
				rotateLeft: 0,
				rotateRight: 0,
				flipHorizontal: 0,
				flipVertical: 0,
			},
			navbar: true,
			title: 0,
			tooltip: true,
			movable: true,
			zoomable: true,
			rotatable: false,
			scalable: false,
			transition: true,
			fullscreen: true,
			keyboard: true,
			backdrop: true,
			zoomOnWheel: true,
			zoomRatio: 0.15,
			minZoomRatio: 0.05,
			maxZoomRatio: 20,
			initialCoverage: 0.92,
			url(image) {
				return image.currentSrc || image.src;
			},
			// SVG without width/height can report tiny natural size; fit to viewport.
			viewed() {
				const { imageData, viewerData } = this;
				if (!imageData?.naturalWidth || !viewerData?.width) return;
				const fit = Math.min(
					(viewerData.width * 0.92) / imageData.naturalWidth,
					(viewerData.height * 0.92) / imageData.naturalHeight,
				);
				if (fit > imageData.ratio + 0.02) this.zoomTo(fit, false);
			},
		});
	}

	bind();
	document.addEventListener('astro:before-swap', destroy);
	document.addEventListener('astro:page-load', bind);
</script>

<style is:global>
	.sl-markdown-content img {
		cursor: zoom-in;
	}

	/* Sit above Starlight header / sidebar chrome */
	.viewer-container {
		z-index: 10000;
	}

	/* Soften Viewer default chrome to match site tone */
	.viewer-backdrop {
		background-color: rgb(0 0 0 / 78%);
	}

	.viewer-footer {
		background: linear-gradient(transparent, rgb(0 0 0 / 55%));
	}

	.viewer-toolbar > ul > li {
		background-color: rgb(28 25 23 / 72%);
	}

	.viewer-toolbar > ul > li:hover {
		background-color: rgb(28 25 23 / 92%);
	}
</style>
