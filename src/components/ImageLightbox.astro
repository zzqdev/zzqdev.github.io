---
/**
 * Site-wide image lightbox for markdown/MDX content.
 * Uses event delegation so newly added images work without per-page setup.
 */
---

<dialog id="image-lightbox" class="image-lightbox" aria-label="图片预览">
	<form method="dialog" class="image-lightbox__bar">
		<button type="submit" class="image-lightbox__close" aria-label="关闭预览">关闭</button>
	</form>
	<img class="image-lightbox__img" alt="" />
</dialog>

<script>
	const ROOT = '.sl-markdown-content';

	function getDialog() {
		return document.getElementById('image-lightbox');
	}

	function getPreviewImage(dialog) {
		return dialog?.querySelector('.image-lightbox__img');
	}

	function openLightbox(img) {
		const dialog = getDialog();
		const preview = getPreviewImage(dialog);
		if (!(dialog instanceof HTMLDialogElement) || !(preview instanceof HTMLImageElement)) return;

		preview.removeAttribute('width');
		preview.removeAttribute('height');
		preview.src = img.currentSrc || img.src;
		preview.alt = img.alt || '放大预览';
		if (!dialog.open) dialog.showModal();
	}

	function onDocumentClick(event) {
		const target = event.target;
		if (!(target instanceof Element)) return;

		const dialog = getDialog();
		if (dialog instanceof HTMLDialogElement && dialog.open && event.target === dialog) {
			dialog.close();
			return;
		}

		const img = target.closest(`${ROOT} img`);
		if (!(img instanceof HTMLImageElement)) return;
		if (img.closest('a[href]')) return;

		event.preventDefault();
		openLightbox(img);
	}

	function onKeydown(event) {
		if (event.key !== 'Escape') return;
		const dialog = getDialog();
		if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close();
	}

	function bind() {
		if (window.__zzqImageLightboxBound) return;
		window.__zzqImageLightboxBound = true;
		document.addEventListener('click', onDocumentClick);
		document.addEventListener('keydown', onKeydown);
	}

	bind();
	document.addEventListener('astro:page-load', bind);
</script>

<style is:global>
	.sl-markdown-content img {
		cursor: zoom-in;
	}

	/* Full-viewport modal: avoid UA/dialog margin quirks that pin content to top-left */
	.image-lightbox {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 1rem;
		border: none;
		background: transparent;
		box-sizing: border-box;
	}

	.image-lightbox[open] {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
	}

	.image-lightbox::backdrop {
		background: rgb(0 0 0 / 78%);
		backdrop-filter: blur(2px);
	}

	.image-lightbox__bar {
		display: flex;
		justify-content: flex-end;
		width: min(96vw, 1400px);
		flex: 0 0 auto;
	}

	.image-lightbox__close {
		appearance: none;
		border: 1px solid rgb(255 255 255 / 35%);
		background: rgb(28 25 23 / 85%);
		color: #fff;
		border-radius: 9999px;
		padding: 0.35rem 0.85rem;
		font-size: 0.875rem;
		cursor: pointer;
	}

	.image-lightbox__close:hover {
		background: rgb(28 25 23 / 100%);
	}

	/* Explicit width so SVG (viewBox-only) does not collapse to a tiny corner */
	.image-lightbox__img {
		display: block;
		width: min(96vw, 1400px);
		height: auto;
		max-height: calc(100vh - 4.5rem);
		object-fit: contain;
		border-radius: 0.75rem;
		background: #f7f6f3;
		box-shadow: 0 16px 48px rgb(0 0 0 / 35%);
		cursor: default;
	}
</style>
